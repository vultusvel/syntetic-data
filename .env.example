# Copy to .env and fill in values:  cp .env.example .env

# --- GCP / Vertex AI ---
GCP_PROJECT=gd-gcp-gridu-genai
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- PostgreSQL (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synthetic
DB_USER=postgres
DB_PASSWORD=postgres

# --- Langfuse observability (optional — app runs without these) ---
# Langfuse UI is exposed on host port 3000 (see docker-compose.yml).
# Open http://localhost:3000, create an account + project, generate API keys,
# and paste them below.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
